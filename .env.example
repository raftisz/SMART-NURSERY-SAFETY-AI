# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริงในไฟล์ .env เท่านั้น
#   cp .env.example .env
# ไฟล์ .env ถูก ignore ใน git แล้ว ห้าม commit

# LINE Messaging API: Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# LINE User ID ของผู้รับ (ขึ้นต้นด้วย U)
LINE_USER_ID=

# (ไม่บังคับ) HTTPS URL สาธารณะที่เก็บภาพ ถ้าเว้นว่าง ข้อความจะบอกชื่อไฟล์ภาพแทน
LINE_IMAGE_BASE_URL=
